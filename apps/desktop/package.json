{
  "name": "@vibeone/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build:web": "vite build",
    "build:electron": "node ../../scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron": "npm run build:electron && electron .",
    "bundle:electron": "node ../../scripts/bundle-electron.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.4",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "main": "dist-electron/main.cjs"
}
