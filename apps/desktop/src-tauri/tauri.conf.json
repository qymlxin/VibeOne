{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeOne",
  "version": "0.1.0",
  "identifier": "dev.vibeone.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeOne",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src https: http:; script-src 'self' blob: 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "bin/vibeone-host": "bin/vibeone-host",
      "runtime/": "runtime/",
      "web/": "web/",
      "examples/": "examples/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
