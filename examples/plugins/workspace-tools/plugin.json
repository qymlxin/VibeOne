{
  "manifestVersion": 1,
  "id": "dev.vibeone.workspace-tools",
  "name": "工作区工具",
  "version": "0.1.0",
  "engines": {
    "pluginApi": ">=0.1 <0.2"
  },
  "entrypoints": {
    "worker": {
      "path": "dist/worker.js",
      "runtime": "node",
      "protocolVersion": 1
    },
    "app": {
      "path": "app.mjs"
    }
  },
  "contributions": [
    {
      "id": "scan",
      "kind": "app.command",
      "kindVersion": 1,
      "binding": {
        "type": "worker",
        "handler": "workspace.scan"
      }
    },
    {
      "id": "workspace-panel",
      "kind": "app.panel",
      "kindVersion": 1,
      "binding": {
        "type": "app"
      },
      "surface": "workspace.tool",
      "title": "工作区扫描",
      "description": "通过插件 Worker 检查授权工作区",
      "icon": "folder"
    },
    {
      "id": "workspace-settings",
      "kind": "settings.section",
      "kindVersion": 1,
      "binding": {
        "type": "app"
      }
    },
    {
      "id": "notify",
      "kind": "notification.channel",
      "kindVersion": 1,
      "binding": {
        "type": "worker",
        "handler": "notifications.receive"
      }
    },
    {
      "id": "demo-agent",
      "kind": "agent.provider",
      "kindVersion": 1,
      "binding": {
        "type": "declarative",
        "descriptor": {
          "name": "插件示例 Agent（不调用模型）",
          "command": "$node",
          "args": [
            "$package/dist/demo-agent.mjs"
          ]
        }
      }
    }
  ],
  "hostRequirements": [
    "workspace.read",
    "notifications.send",
    "agent.spawn"
  ]
}
