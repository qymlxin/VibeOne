{
  "name": "vibeone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @vibeone/plugin-sdk && npm run build -w @vibeone/plugin-runtime && npm run build -w @vibeone/example-workspace-tools",
    "test": "npm run build && node --test packages/*/test/*.test.mjs",
    "check": "npm test && cargo test --workspace && npm run host:test && npm run storage:test",
    "host:test": "cargo build -p vibeone-host && node --test tests/workbench.test.mjs tests/execution.test.mjs tests/workspace.test.mjs",
    "desktop:test": "cargo build -p vibeone-host && node --test tests/desktop.test.mjs",
    "agent:smoke": "cargo build -p vibeone-host && node scripts/smoke-real-agents.mjs",
    "plugin:scan": "npm run build && cargo run -p vibeone-host -- plugin scan --workspace .",
    "desktop": "node scripts/prepare-desktop.mjs && npm run desktop -w @vibeone/desktop",
    "desktop:bundle": "node scripts/prepare-desktop.mjs && npm run desktop:build -w @vibeone/desktop -- --debug",
    "desktop:build": "node scripts/prepare-desktop.mjs --release && npm run desktop:build -w @vibeone/desktop",
    "prototype": "vite prototype --host 127.0.0.1 --port 4173",
    "prototype:build": "vite build prototype --outDir ../prototype-dist",
    "storage:test": "cargo build -p vibeone-host && node --test tests/recovery.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
