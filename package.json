{
  "name": "vibeone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @vibeone/plugin-sdk && npm run build -w @vibeone/plugin-runtime",
    "test": "npm run build && node --test packages/*/test/*.test.mjs",
    "check": "npm test && cargo test --workspace",
    "prototype": "vite prototype --host 127.0.0.1 --port 4173",
    "prototype:build": "vite build prototype --outDir ../prototype-dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
